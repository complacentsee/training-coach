# The auto-grader's configuration. Copy this beside a stack's compose file
# as "grader.env" — that name is gitignored, because a real one carries an
# API key. Both compose files read it optionally, so a stack with no file at
# all simply runs with grading off.
#
# Modes: off (default) | dry | live. dry logs the would-be grade and note
# without posting; that is how judgment earns its way to live. A typo in
# any of these is a startup failure, not a silent off.
GRADER_MODE=off

# anthropic | openai. "openai" covers any OpenAI-compatible base URL,
# including a local Ollama; Ollama also speaks the Anthropic dialect since
# v0.14.0, in which case set GRADER_DIALECT=anthropic against its base URL.
GRADER_PROVIDER=anthropic
#GRADER_DIALECT=anthropic

# Defaults to claude-opus-5 on anthropic; required for openai.
GRADER_MODEL=claude-opus-5

# Defaults to the provider's own API. A local model looks like
# http://host:11434 with GRADER_PROVIDER=openai.
GRADER_BASE_URL=https://api.anthropic.com

GRADER_API_KEY=

# Bounds data/grading-notes.md, the athlete-specific overlay appended to the
# embedded procedure, in bytes. Default 16384 — roughly three times a typical
# overlay against a 7.5 KB procedure. It is the one prompt input with no
# natural ceiling: a hand-edited file, read fresh every run, so a runaway edit
# would otherwise crowd out the measured numbers. Raise it where the model has
# the room. Anything past the cut is NOT applied, and the log says so on every
# run that trims.
#GRADER_NOTES_MAX=16384
